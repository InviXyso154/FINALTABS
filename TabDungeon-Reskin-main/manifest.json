{
  "manifest_version": 3,
  "name": "TabDungeon",
  "version": "1.0",
  "description": "Flashcard study helper that adapts review timing to what you read",
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "alarms",
    "scripting",
    "idle"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  }
}